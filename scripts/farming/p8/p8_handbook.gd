# Agricultural rules are shared verbatim with the encyclopedia's compiled source.
static var CHAPTERS: Array = _chapters()

static func _chapters() -> Array:
	var result := BASE_CHAPTERS.duplicate(true)
	var data: Dictionary = JSON.parse_string(FileAccess.get_file_as_string("res://content/farming/baked/encyclopedia/encyclopedia.json"))
	for id in ["rule:economy-stages","rule:agriculture","rule:rooms","rule:animal-zones","rule:animal-services","rule:water-systems"]:
		for entity in data["entities"]:
			if entity["id"] != id: continue
			var cards := []
			for field in entity["fields"]:
				if field["key"]=="statements": cards.append({"title":"规则与操作","steps":String(field["text"]).split("\n")})
			var chapter := {"id":id.trim_prefix("rule:"),"title":entity["name"],"cards":cards}
			if id == "rule:economy-stages": result.insert(1, chapter)
			else: result.append(chapter)
	return result

static func chapter(id: String) -> Dictionary:
	for entry in CHAPTERS:
		if entry["id"] == id: return entry
	return CHAPTERS[0]

static func markdown() -> String:
	var result := "# 灵田P8新手手册\n\n"
	result += "本手册对应P8生态产业本地测试版。工作区直接运行 `play.bat`（或 `play.bat p8`），Godot F5也进入P8；V2使用显式入口 `play.bat v2`。游戏内点击顶栏“手册”，选择章节阅读，也可直接进入市集、营建、研究、雇工、资源一览或订单。\n\n"
	result += "以下以2026-10-12验证的A/B经营样本说明操作，不要求照着指定日期发展。先读“从零开始”，需要时再查其他章节。\n\n"
	for entry in CHAPTERS:
		result += "## %s\n\n" % entry["title"]
		for card in entry["cards"]:
			result += "### %s\n\n" % card["title"]
			for index in range(card["steps"].size()):
				result += "%d. %s\n" % [index + 1, card["steps"][index]]
			result += "\n"
	result += "A/B样本记录见[经营补验](phase-08h-调试记录.md#10-2026-10-12四项经营补验)；V2玩家请阅读[V2操作说明](demo-v2-操作说明.md)。\n"
	return result
